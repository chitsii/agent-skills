#!/usr/bin/env python3
"""skills — スキルセットを Claude Code / Codex CLI の探索パスへ配置する。

  skills use  <set>... [--global] [--link]   セットを配置する (既定: カレントの git リポジトリ)
  skills drop <set>... [--global]            セットを外す
  skills status                              ここと global に何が配置されているか (古いコピーは STALE)
  skills list                                利用可能なセットとスキル
  skills sync                                git pull → 壊れたものを掃除 → 配置済みセットを更新
  skills doctor [--claude]                   両ツールが実際に認識しているか検証

既定はコピー。プロジェクト内に実体があるので、どの環境でも設定変更なしで動く。
--link は symlink。編集が即反映されるが、Claude Code が references/ を読むには
~/.claude/settings.json の permissions.additionalDirectories にこの repo が必要。
"""
import argparse
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent  # ~/.local/bin/skills の symlink を辿って repo root
SETS = ROOT / "sets"
# 両ツールの探索パス (docs/research.md §2)。~/.codex/skills は Codex が .system/ を書く場所なので使わない。
SUBDIRS = (".claude/skills", ".agents/skills")
MARKER = ".agent-skills.json"  # コピーしたスキル dir に置く。由来のセットと内容ハッシュ
MARK_BEGIN = "# >>> agent-skills >>>"
MARK_END = "# <<< agent-skills <<<"


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def git_toplevel(path=None):
    r = subprocess.run(["git", "rev-parse", "--show-toplevel"], cwd=path, capture_output=True, text=True)
    return Path(r.stdout.strip()) if r.returncode == 0 else None


def project_base():
    return git_toplevel() or Path.cwd()


def list_sets():
    if not SETS.is_dir():
        return []
    return sorted(p.name for p in SETS.iterdir() if p.is_dir() and not p.name.startswith("."))


def set_dir(name):
    d = SETS / name
    if not d.is_dir():
        die(f"unknown set: {name}  (available: {', '.join(list_sets()) or 'none'})")
    return d


def skills_in(set_path):
    return sorted(p for p in set_path.iterdir() if p.is_dir() and (p / "SKILL.md").exists())


def frontmatter(skill_md):
    """name/description 程度の単純な frontmatter だけ読む (pyyaml 非依存)。"""
    m = re.match(r"---\n(.*?)\n---", skill_md.read_text(encoding="utf-8"), re.S)
    fm = {}
    if m:
        for line in m.group(1).splitlines():
            if line[:1].isspace():
                continue
            k, sep, v = line.partition(":")
            if sep:
                fm[k.strip()] = v.strip().strip('"').strip("'")
    return fm


def content_hash(d):
    h = hashlib.sha256()
    for f in sorted(p for p in d.rglob("*") if p.is_file() and p.name != MARKER):
        h.update(str(f.relative_to(d)).encode())
        h.update(f.read_bytes())
    return h.hexdigest()[:16]


class Entry:
    """配置済みスキル一つ。mode は 'copy' か 'link'。"""

    def __init__(self, path, set_name, mode):
        self.path, self.set_name, self.mode = path, set_name, mode
        self.source = SETS / set_name / path.name

    @property
    def broken(self):
        return not self.source.exists() or (self.mode == "link" and not self.path.exists())

    @property
    def stale(self):
        if self.mode != "copy" or self.broken:
            return False
        return content_hash(self.path) != content_hash(self.source)

    def remove(self):
        if self.path.is_symlink():
            self.path.unlink()
        else:
            shutil.rmtree(self.path)


def owned_entries(target_dir):
    """target_dir 内で、この repo が配置したもの (sets/ への symlink か MARKER 付きの dir)。"""
    out = []
    if not target_dir.is_dir():
        return out
    for p in sorted(target_dir.iterdir()):
        if p.is_symlink():
            try:
                rel = Path(os.readlink(p)).relative_to(SETS)
            except ValueError:
                continue
            out.append(Entry(p, rel.parts[0], "link"))
        elif p.is_dir() and (p / MARKER).exists():
            try:
                meta = json.loads((p / MARKER).read_text())
                out.append(Entry(p, meta["set"], "copy"))
            except (json.JSONDecodeError, KeyError):
                continue
    return out


def write_exclude(base):
    """.git/info/exclude に、この repo が配置したものだけを列挙したブロックを書く。
    共有の .gitignore は触らない。base が git toplevel でなければ何もしない。"""
    top = git_toplevel(base)
    if not top or top.resolve() != base.resolve():
        return
    excl = top / ".git" / "info" / "exclude"
    excl.parent.mkdir(parents=True, exist_ok=True)
    lines = excl.read_text().splitlines() if excl.exists() else []
    if MARK_BEGIN in lines and MARK_END in lines:
        i, j = lines.index(MARK_BEGIN), lines.index(MARK_END)
        lines = lines[:i] + lines[j + 1 :]
    entries = [f"{sub}/{e.path.name}" for sub in SUBDIRS for e in owned_entries(base / sub)]
    if entries:
        lines += [MARK_BEGIN, *entries, MARK_END]
    excl.write_text("\n".join(lines).rstrip("\n") + "\n")


def place(skill, dst_dir, set_name, link):
    dst_dir.mkdir(parents=True, exist_ok=True)
    target = dst_dir / skill.name
    if target.is_symlink():
        target.unlink()
    elif target.is_dir():
        if (target / MARKER).exists():
            shutil.rmtree(target)
        else:
            print(f"skip  {target}  (この repo 由来でない実体が存在)")
            return
    elif target.exists():
        print(f"skip  {target}  (ファイルが存在)")
        return
    if link:
        target.symlink_to(skill)
        print(f"link  {target}  ->  {skill.relative_to(ROOT)}")
    else:
        shutil.copytree(skill, target)
        meta = {"set": set_name, "hash": content_hash(skill), "source": str(ROOT)}
        (target / MARKER).write_text(json.dumps(meta) + "\n")
        print(f"copy  {target}  <-  {skill.relative_to(ROOT)}")


def place_set(name, base, link):
    skills = skills_in(set_dir(name))
    if not skills:
        print(f"note: set '{name}' has no skills yet")
    for skill in skills:
        for sub in SUBDIRS:
            place(skill, base / sub, name, link)


def cmd_use(args):
    base = Path.home() if args.glob else project_base()
    for name in args.sets:
        place_set(name, base, args.link)
    write_exclude(base)
    if args.link and not ROOT.resolve().is_relative_to(base.resolve()):
        # リンク先がプロジェクト外だと Claude Code は Read 時に権限で弾く。repo 自身に張る場合は不要。
        print(f"note: --link で Claude Code に references/ を読ませるには ~/.claude/settings.json の\n"
              f"      permissions.additionalDirectories に {ROOT} を追加する")


def cmd_drop(args):
    base = Path.home() if args.glob else project_base()
    for sub in SUBDIRS:
        for e in owned_entries(base / sub):
            if e.set_name in args.sets:
                e.remove()
                print(f"remove  {e.path}")
    write_exclude(base)


def cmd_status(args):
    for label, base in (("project", project_base()), ("global", Path.home())):
        print(f"[{label}] {base}")
        found = False
        for sub in SUBDIRS:
            for e in owned_entries(base / sub):
                found = True
                flag = "  (BROKEN)" if e.broken else "  (STALE: skills sync で更新)" if e.stale else ""
                print(f"  {sub}/{e.path.name:<24} <- {e.set_name} [{e.mode}]{flag}")
        if not found:
            print("  (none)")


def cmd_list(args):
    sets = list_sets()
    if not sets:
        print("(no sets)")
    for s in sets:
        print(f"{s}/")
        for sk in skills_in(SETS / s):
            fm = frontmatter(sk / "SKILL.md")
            print(f"  {sk.name:<24} {fm.get('description', '')[:90]}")


def cmd_sync(args):
    has_upstream = subprocess.run(["git", "-C", str(ROOT), "rev-parse", "--abbrev-ref", "@{u}"],
                                  capture_output=True).returncode == 0
    if has_upstream:
        subprocess.run(["git", "-C", str(ROOT), "pull", "--ff-only"], check=False)
    else:
        print(f"note: {ROOT} has no upstream, skip pull")
    for base in dict.fromkeys([project_base(), Path.home()]):
        in_use = {}  # set_name -> mode
        for sub in SUBDIRS:
            for e in owned_entries(base / sub):
                if e.broken:
                    e.remove()
                    print(f"clean  {e.path}")
                    continue
                in_use.setdefault(e.set_name, e.mode)
        for s, mode in sorted(in_use.items()):
            if (SETS / s).is_dir():
                place_set(s, base, link=(mode == "link"))
        write_exclude(base)


def codex_view(cwd):
    """codex debug prompt-input から Codex が実際に見ているスキルルートと名前を取る (API 呼び出しなし)。"""
    r = subprocess.run(["codex", "debug", "prompt-input"], capture_output=True, text=True, cwd=cwd)
    block = ""
    try:
        for item in json.loads(r.stdout):
            for c in item.get("content", []) if isinstance(item, dict) else []:
                t = c.get("text", "") if isinstance(c, dict) else ""
                if "<skills_instructions>" in t:
                    block = t
    except json.JSONDecodeError:
        block = r.stdout.replace("\\n", "\n")
    roots = re.findall(r"- `r\d+` = `([^`]+)`", block)
    names = re.findall(r"^- ([A-Za-z0-9_.-]+):", block, re.M)
    return roots, names


def cmd_doctor(args):
    base = project_base()
    expected = set()
    problems = 0
    for b in (base, Path.home()):
        for sub in SUBDIRS:
            for e in owned_entries(b / sub):
                expected.add(e.path.name)
                if e.broken:
                    problems += 1
                    print(f"BROKEN  {e.path}")
                elif e.stale:
                    problems += 1
                    print(f"STALE   {e.path}  (skills sync)")
    print(f"placed: {len(expected)} skills, {'ok' if not problems else f'{problems} problems'}")

    if shutil.which("codex"):
        roots, names = codex_view(base)
        print("codex roots:")
        for r in roots:
            print(f"  {r}")
        missing = sorted(expected - set(names))
        print(f"codex sees: {', '.join(sorted(set(names) & expected)) or '(none of ours)'}")
        if missing:
            print(f"codex MISSING: {', '.join(missing)}")
    else:
        print("codex: not installed")

    if args.claude and shutil.which("claude"):
        prompt = "List the names of every skill available to you, one per line, nothing else."
        r = subprocess.run(["claude", "--model", "haiku", "-p", prompt], capture_output=True, text=True, cwd=base)
        seen = set(re.findall(r"[A-Za-z0-9_.-]+", r.stdout))
        missing = sorted(expected - seen)
        print(f"claude sees: {', '.join(sorted(seen & expected)) or '(none of ours)'}")
        if missing:
            print(f"claude MISSING: {', '.join(missing)}")
    else:
        print("claude: セッション内で /skills か /skill-doctor で確認 (--claude で haiku に1回問い合わせて検証)")


def main():
    p = argparse.ArgumentParser(prog="skills", description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    sp = p.add_subparsers(dest="cmd", required=True)
    u = sp.add_parser("use")
    u.add_argument("sets", nargs="+")
    u.add_argument("--global", dest="glob", action="store_true")
    u.add_argument("--link", action="store_true", help="コピーではなく symlink で配置")
    u.set_defaults(fn=cmd_use)
    d = sp.add_parser("drop")
    d.add_argument("sets", nargs="+")
    d.add_argument("--global", dest="glob", action="store_true")
    d.set_defaults(fn=cmd_drop)
    sp.add_parser("status").set_defaults(fn=cmd_status)
    sp.add_parser("list").set_defaults(fn=cmd_list)
    sp.add_parser("sync").set_defaults(fn=cmd_sync)
    dr = sp.add_parser("doctor")
    dr.add_argument("--claude", action="store_true")
    dr.set_defaults(fn=cmd_doctor)
    args = p.parse_args()
    args.fn(args)


if __name__ == "__main__":
    main()
